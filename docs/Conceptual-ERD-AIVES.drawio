        </mxCell>
        <mxCell id="relations-heading" value="RELATIONSHIPS AND CARDINALITIES" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=24;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="120" y="780" width="2160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="rel-1" value="○  A lecturer creates and owns 0..* exam sessions; each session has exactly 1 lecturer." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="120" y="842" width="1050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-2" value="○  A lecturer finalizes 0..* assessments; an assessment has 0..1 finalizing lecturer." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="120" y="969" width="1050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-3" value="○  A course contains 0..* questions; each question belongs to 1 course." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="120" y="1096" width="1050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-4" value="○  A course has 0..* exam sessions; each session belongs to 1 course." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="120" y="1223" width="1050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-5" value="○  A question has 1..* rubrics; each rubric belongs to 1 question." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="120" y="1350" width="1050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-6" value="○  An exam session contains 1..* session questions; each selection belongs to 1 session." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="120" y="1477" width="1050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-7" value="○  A question may be selected in 0..* session questions; each selection refers to 1 question." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="1230" y="842" width="1050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-8" value="○  A student submits 0..* transcripts; each transcript belongs to 1 student and 1 exam session." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="1230" y="969" width="1050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-9" value="○  An exam session has 0..* transcripts; at most 1 transcript per student per session." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="1230" y="1096" width="1050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-10" value="○  A transcript stores 0..* transcript turns; each turn belongs to 1 transcript." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="1230" y="1223" width="1050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-11" value="○  A transcript has 0..* assessments; each assessment evaluates 1 question in that transcript." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="1230" y="1350" width="1050" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-12" value="○  Assessment is per transcript/question; its lecturer final score is optional until review." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="1230" y="1477" width="1050" height="100" as="geometry" />
        </mxCell>
