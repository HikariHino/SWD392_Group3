        </mxCell>
        <mxCell id="bloom-vals" parent="bloom" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=12;fontFamily=Consolas;whiteSpace=wrap;overflow=hidden;" value="+ Remember = 1&#10;+ Understand = 2&#10;+ Apply = 3&#10;+ Analyze = 4&#10;+ Evaluate = 5&#10;+ Create = 6" vertex="1">
          <mxGeometry height="144" width="280" y="36" as="geometry" />
        </mxCell>
        <mxCell id="e-question-bloom" edge="1" parent="1" source="question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;strokeColor=#64748b;jumpStyle=arc;jumpSize=8;exitX=0.85;exitY=0;entryX=0;entryY=0.5;" target="bloom" value="uses">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1834" y="1470" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="assumptions" parent="1" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#fffbeb;strokeColor=#d6b656;fontSize=16;" value="DESIGN SCOPE&#10;&#10;This is a proposed design and is not fully aligned with the current code.&#10;&lt;&lt;planned&gt;&gt;: ExamSession, Transcript, and Assessment do not yet have entities or CRUD operations.&#10;&#10;Multiplicity for these three planned entities is a design assumption that requires team confirmation.&#10;Transcript here represents one student’s result for one exam session; this differs from the conversation model in Conceptual_ERD.md.&#10;&#10;A valid Question has at least one Rubric; total Weight = 100%.&#10;Business methods shown on entities are proposed.&#10;&#10;Inheritance to BaseEntity is simplified: the current code has an intermediate AuditableEntity class." vertex="1">
          <mxGeometry height="430" width="590" x="2700" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="ownership" parent="1" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#fffbeb;strokeColor=#d6b656;fontSize=16;" value="COMPOSITION / AGGREGATION&#10;&#10;Question ◆── Rubric: composition.&#10;The filled diamond is placed at Question (the whole).&#10;Each Rubric belongs to exactly 1 Question; each valid Question has 1..* Rubrics.&#10;Rubrics are managed within the Question lifecycle.&#10;&#10;An open diamond represents aggregation, where the part can exist independently. Do not add one only because a foreign key exists." vertex="1">
          <mxGeometry height="280" width="590" x="2700" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="dip-note" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontColor=#172554;fontSize=17;fillColor=#eff6ff;" value="Technical-layer association: each Controller / Service / Repository holds exactly 1 target object; a target object may be referenced by 0..* source objects (this does not constrain the DI lifecycle). The current code has 4 DbSets; the 3 exam/result DbSets shown here are proposed. Inheritance/realization relationships have no multiplicity." vertex="1">
          <mxGeometry height="70" width="3240" x="50" y="2280" as="geometry" />
        </mxCell>
        <mxCell id="reference" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontColor=#172554;fontSize=14;fontColor=#64748b;" value="Notation references: viblo.asia/p/tim-hieu-ve-cach-thiet-ke-class-diagram-L4x5xLyY5BM | drawio.com/docs/diagram-types/uml/class-diagrams/" vertex="1">
          <mxGeometry height="35" width="3240" x="50" y="2370" as="geometry" />
        </mxCell>
