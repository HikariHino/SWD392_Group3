        <mxCell id="domain-title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontColor=#172554;fillColor=#dcfce7;fontSize=20;fontStyle=1;" value="04  DOMAIN — các entity không phụ thuộc Web API hoặc Entity Framework" vertex="1">
          <mxGeometry height="50" width="2550" x="50" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="notation" parent="1" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#fffbeb;strokeColor=#d6b656;fontSize=16;" value="KÝ HIỆU UML&#xa;&#xa;+ Public     - Private     # Protected&#xa;Tên lớp → Thuộc tính → Phương thức&#xa;&#xa;Nét liền + tam giác rỗng: kế thừa.&#xa;Nét đứt + tam giác rỗng: thực thi interface.&#xa;Nét đứt + mũi tên mở: dependency.&#xa;Nét liền + mũi tên mở: association có hướng.&#xa;Nét liền không mũi tên: association.&#xa;&#xa;1: đúng một. 0..*: không hoặc nhiều.&#xa;Các nhánh kế thừa Domain cùng hướng về BaseEntity." vertex="1">
          <mxGeometry height="400" width="590" x="2700" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="bloom" parent="1" style="swimlane;html=0;startSize=36;horizontal=1;collapsible=0;rounded=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;fontSize=14;fontStyle=1;align=center;whiteSpace=wrap;" value="&lt;&lt;enumeration&gt;&gt;&#xa;BloomLevel" vertex="1">
          <mxGeometry height="180" width="280" x="2080" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="bloom-vals" parent="bloom" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=12;fontFamily=Consolas;whiteSpace=wrap;overflow=hidden;" value="+ Remember = 1&#xa;+ Understand = 2&#xa;+ Apply = 3&#xa;+ Analyze = 4&#xa;+ Evaluate = 5&#xa;+ Create = 6" vertex="1">
          <mxGeometry height="144" width="280" y="36" as="geometry" />
