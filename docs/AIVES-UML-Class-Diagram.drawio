        <mxCell id="assumptions" parent="1" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#fffbeb;strokeColor=#d6b656;fontSize=16;" value="GIẢ ĐỊNH &amp; ĐỒNG BỘ THIẾT KẾ&#xa;&#xa;1. Đồng bộ 100% với Backend .NET 10 &amp; Swagger:&#xa;• QuestionsController &amp; IQuestionBankService đầy đủ CRUD (GetQuestions phân trang, Create, Update, Delete).&#xa;• Question sử dụng BloomLevel (Nhớ, Hiểu, Vận dụng, Phân tích, Đánh giá, Sáng tạo).&#xa;• Rubric có Weight (%) phục vụ validation tổng trọng số = 100%.&#xa;&#xa;2. BaseEntity.Id ánh xạ tới khóa chính Guid từng bảng.&#xa;&#xa;3. Các bảng ExamSession, Transcript, Assessment thiết kế trước cho toàn bộ vòng đời Viva Exam AIVES." vertex="1">
          <mxGeometry height="430" width="590" x="2700" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="ownership" parent="1" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#fffbeb;strokeColor=#d6b656;fontSize=16;" value="VÒNG ĐỜI / SỞ HỮU&#xa;&#xa;◆ Composition: hình thoi đặc ở toàn thể.&#xa;◇ Aggregation: hình thoi rỗng ở toàn thể.&#xa;&#xa;Không suy ra hai quan hệ này chỉ từ FK.&#xa;Nếu Rubric thuộc riêng Question và không tồn tại độc lập, thay association bằng composition, ◆ đặt tại Question." vertex="1">
          <mxGeometry height="280" width="590" x="2700" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="dip-note" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontColor=#172554;fontSize=17;fillColor=#eff6ff;" value="DIP: QuestionBankService giữ tham chiếu IQuestionRepository (Application); QuestionRepository (Infrastructure) thực thi interface đó. Service không phụ thuộc AivesDbContext.&#xa;AivesDbContext sử dụng 7 entity thông qua DbSet. OnModelCreating và SaveChangesAsync là override. Constructor không khai báo kiểu trả về." vertex="1">
          <mxGeometry height="70" width="3240" x="50" y="2280" as="geometry" />
