        <mxCell id="subtitle" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontColor=#172554;fontSize=19;" value="Onion Architecture + mô hình dữ liệu | Thiết kế đề xuất | 14 lớp/interface nghiệp vụ và 2 lớp framework" vertex="1">
          <mxGeometry height="45" width="3200" x="50" y="85" as="geometry" />
        </mxCell>
        <mxCell id="api-title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontColor=#172554;fillColor=#dbeafe;fontSize=19;fontStyle=1;" value="01  WEB API" vertex="1">
