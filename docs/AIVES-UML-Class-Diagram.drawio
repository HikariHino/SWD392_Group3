        <mxCell id="infra-title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontColor=#172554;fillColor=#ede9fe;fontSize=19;fontStyle=1;" value="03  INFRASTRUCTURE" vertex="1">
          <mxGeometry height="45" width="1260" x="2030" y="155" as="geometry" />
        </mxCell>
        <mxCell id="domain-title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontColor=#172554;fillColor=#dcfce7;fontSize=20;fontStyle=1;" value="04  DOMAIN — các entity không phụ thuộc Web API hoặc Entity Framework" vertex="1">
          <mxGeometry height="50" width="2550" x="50" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="notation" parent="1" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#fffbeb;strokeColor=#d6b656;fontSize=16;" value="KÝ HIỆU UML&#xA;&#xA;+ Public     - Private     # Protected&#xA;Tên lớp → Thuộc tính → Phương thức&#xA;&#xA;Kế thừa: nét liền, tam giác rỗng hướng về lớp cha.&#xA;Realization: nét đứt, tam giác rỗng hướng về interface.&#xA;Dependency: nét đứt, mũi tên mở.&#xA;Association: nét liền; mũi tên mở chỉ hướng truy cập.&#xA;&#xA;MULTIPLICITY (ở hai đầu association)&#xA;1: đúng một; 0..1: không hoặc một.&#xA;0..*: không hoặc nhiều; 1..*: một hoặc nhiều.&#xA;Không gắn multiplicity lên kế thừa, realization hoặc dependency." vertex="1">
          <mxGeometry height="430" width="590" x="2700" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="bloom" parent="1" style="swimlane;html=0;startSize=36;horizontal=1;collapsible=0;rounded=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;fontSize=14;fontStyle=1;align=center;whiteSpace=wrap;" value="&lt;&lt;enumeration&gt;&gt;&#xA;BloomLevel" vertex="1">
          <mxGeometry height="180" width="280" x="2080" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="bloom-vals" parent="bloom" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=12;fontFamily=Consolas;whiteSpace=wrap;overflow=hidden;" value="+ Remember = 1&#xA;+ Understand = 2&#xA;+ Apply = 3&#xA;+ Analyze = 4&#xA;+ Evaluate = 5&#xA;+ Create = 6" vertex="1">
          <mxGeometry height="144" width="280" y="36" as="geometry" />
        </mxCell>
        <mxCell id="e-question-bloom" edge="1" parent="1" source="question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;strokeColor=#64748b;jumpStyle=arc;jumpSize=8;exitX=0.85;exitY=0;entryX=0;entryY=0.5;" target="bloom" value="uses">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1834" y="1470" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="assumptions" parent="1" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#fffbeb;strokeColor=#d6b656;fontSize=16;" value="PHẠM VI THIẾT KẾ&#xA;&#xA;Đây là thiết kế đề xuất, chưa đồng bộ toàn bộ với code.&#xA;&lt;&lt;planned&gt;&gt;: ExamSession, Transcript, Assessment chưa có entity/CRUD.&#xA;&#xA;Multiplicity của ba entity planned là giả định thiết kế, cần nhóm xác nhận.&#xA;Transcript ở sơ đồ này là kết quả một sinh viên trong một ca thi; khác mô hình hội thoại trong Conceptual_ERD.md.&#xA;&#xA;Question có ít nhất 1 Rubric hợp lệ; tổng Weight = 100%.&#xA;Các phương thức nghiệp vụ trên entity là đề xuất.&#xA;&#xA;Kế thừa tới BaseEntity được giản lược: code hiện có lớp trung gian AuditableEntity." vertex="1">
          <mxGeometry height="430" width="590" x="2700" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="ownership" parent="1" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#fffbeb;strokeColor=#d6b656;fontSize=16;" value="COMPOSITION / AGGREGATION&#xA;&#xA;Question ◆── Rubric: composition.&#xA;Hình thoi đặc đặt tại Question (toàn thể).&#xA;Mỗi Rubric thuộc đúng 1 Question; mỗi Question hợp lệ có 1..* Rubric.&#xA;Rubric được quản lý cùng vòng đời Question.&#xA;&#xA;Hình thoi rỗng: aggregation, phần có thể tồn tại độc lập. Không thêm chỉ vì có khóa ngoại." vertex="1">
          <mxGeometry height="280" width="590" x="2700" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="dip-note" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontColor=#172554;fontSize=17;fillColor=#eff6ff;" value="Association tầng kỹ thuật: mỗi Controller / Service / Repository giữ đúng 1 đối tượng đích; một đối tượng đích có thể được 0..* đối tượng nguồn tham chiếu (không ràng buộc vòng đời DI). Code hiện có 4 DbSet; 3 DbSet ca thi/kết quả trong sơ đồ là đề xuất. Các quan hệ kế thừa/realization không có multiplicity." vertex="1">
          <mxGeometry height="70" width="3240" x="50" y="2280" as="geometry" />
        </mxCell>
