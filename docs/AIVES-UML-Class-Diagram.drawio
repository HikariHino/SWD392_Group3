        <mxCell id="e-question-bloom" edge="1" parent="1" source="question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;strokeColor=#64748b;jumpStyle=arc;jumpSize=8;exitX=0.85;exitY=0;entryX=0;entryY=0.5;" target="bloom" value="uses">
          <mxGeometry relative="1" as="geometry">
