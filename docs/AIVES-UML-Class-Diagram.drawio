        <mxCell id="title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontColor=#172554;fontSize=32;fontStyle=1;" value="AIVES | UML CLASS DIAGRAM — .NET 10" vertex="1">
