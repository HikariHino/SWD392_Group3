        <mxCell id="app-title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontColor=#172554;fillColor=#dbeafe;fontSize=19;fontStyle=1;" value="02  APPLICATION" vertex="1">
          <mxGeometry height="45" width="1280" x="690" y="155" as="geometry" />
