          <mxGeometry relative="1" as="geometry">
            <mxPoint x="555" y="330" as="sourcePoint" />
            <mxPoint x="670" y="265" as="targetPoint" />
            <Array as="points">
              <mxPoint x="610" y="330" />
              <mxPoint x="610" y="265" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Gateway -> SignalR -->
