<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="aives-system-architecture-clean" name="AIVES System Architecture">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER TITLE -->
        <mxCell id="hdr_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=none;arcSize=12;" vertex="1">
          <mxGeometry x="60" y="30" width="1330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdr_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#ffffff;fontFamily=Arial;fontSize=20;fontStyle=1;" value="🏛️ AIVES — SƠ ĐỒ KIẾN TRÚC HỆ THỐNG TỔNG THỂ (SYSTEM ARCHITECTURE)" vertex="1">
          <mxGeometry x="60" y="35" width="1330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#94a3b8;fontFamily=Arial;fontSize=12;" value="React SPA &amp;nbsp;·&amp;nbsp; API Gateway &amp;nbsp;·&amp;nbsp; .NET 10 Web API &amp;nbsp;·&amp;nbsp; SignalR WebSockets &amp;nbsp;·&amp;nbsp; SQL Server &amp;nbsp;·&amp;nbsp; Azure Speech &amp;nbsp;·&amp;nbsp; Azure OpenAI GPT-4" vertex="1">
          <mxGeometry x="60" y="62" width="1330" height="20" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- 1. CLIENT TIER                                 -->
        <!-- ============================================== -->
        <mxCell id="group_client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontColor=#0369a1;fontFamily=Arial;fontSize=14;fontStyle=1;" value="CLIENT TIER" vertex="1">
          <mxGeometry x="60" y="120" width="240" height="580" as="geometry" />
        </mxCell>

        <!-- Lecturer Card -->
        <mxCell id="c_lecturer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#0f172a;fontFamily=Arial;shadow=1;" value="&lt;div style='font-size:36px; margin-bottom:8px;'&gt;👨‍🏫&lt;/div&gt;&lt;b style='font-size:15px; color:#0369a1;'&gt;Lecturer Web App&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px; color:#64748b;'&gt;React SPA · Question &amp;amp; Rubric&lt;/span&gt;" vertex="1">
          <mxGeometry x="85" y="180" width="190" height="150" as="geometry" />
        </mxCell>

        <!-- Student Card -->
        <mxCell id="c_student" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#0f172a;fontFamily=Arial;shadow=1;" value="&lt;div style='font-size:36px; margin-bottom:8px;'&gt;🎓&lt;/div&gt;&lt;b style='font-size:15px; color:#0369a1;'&gt;Student Web App&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px; color:#64748b;'&gt;React SPA + Audio Stream&lt;/span&gt;" vertex="1">
          <mxGeometry x="85" y="440" width="190" height="150" as="geometry" />
        </mxCell>

        <!-- Peripherals Note -->
        <mxCell id="c_peripherals" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8fafc;strokeColor=#cbd5e1;align=center;verticalAlign=middle;fontColor:#64748b;fontFamily=Arial;fontSize=11;" value="🎙️ Mic &amp;nbsp;|&amp;nbsp; 🎧 Tai nghe &amp;nbsp;|&amp;nbsp; 💻 Browser" vertex="1">
          <mxGeometry x="85" y="620" width="190" height="40" as="geometry" />
        </mxCell>


        <!-- ============================================== -->
        <!-- 2. GATEWAY TIER                                -->
        <!-- ============================================== -->
        <mxCell id="group_gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontColor=#c2410c;fontFamily=Arial;fontSize=14;fontStyle=1;" value="API GATEWAY" vertex="1">
          <mxGeometry x="360" y="120" width="220" height="580" as="geometry" />
        </mxCell>

        <!-- Gateway Card -->
        <mxCell id="c_gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#0f172a;fontFamily=Arial;shadow=1;" value="&lt;div style='font-size:38px; margin-bottom:8px;'&gt;🛡️&lt;/div&gt;&lt;b style='font-size:16px; color:#c2410c;'&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px; color:#64748b;'&gt;NGINX / Reverse Proxy&lt;/span&gt;&lt;hr style='border:0; border-top:1px solid #fed7aa; margin:10px 15px;'&gt;&lt;span style='font-size:11px; color:#475569;'&gt;• TLS 1.3 (HTTPS / WSS)&lt;br&gt;• CORS &amp;amp; Rate Limiting&lt;br&gt;• Reverse Proxy Routing&lt;/span&gt;" vertex="1">
          <mxGeometry x="385" y="270" width="170" height="200" as="geometry" />
        </mxCell>

        <!-- Auth Badge -->
        <mxCell id="c_jwt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#fdba74;align=center;verticalAlign=middle;fontColor:#9a3412;fontFamily=Arial;fontSize=11;fontStyle=1;" value="🔒 JWT Bearer Auth" vertex="1">
          <mxGeometry x="385" y="495" width="170" height="35" as="geometry" />
        </mxCell>


        <!-- ============================================== -->
        <!-- 3. BACKEND TIER (.NET 10)                      -->
        <!-- ============================================== -->
        <mxCell id="group_backend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontColor=#6d28d9;fontFamily=Arial;fontSize=14;fontStyle=1;" value="APPLICATION SERVER (.NET 10)" vertex="1">
          <mxGeometry x="640" y="120" width="310" height="580" as="geometry" />
        </mxCell>

        <!-- REST API WebApi -->
        <mxCell id="c_api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#0f172a;fontFamily=Arial;shadow=1;" value="&lt;div style='font-size:36px; margin-bottom:8px;'&gt;🌐&lt;/div&gt;&lt;b style='font-size:15px; color:#6d28d9;'&gt;ASP.NET Core Web API&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px; color:#64748b;'&gt;.NET 10 · REST Endpoints&lt;/span&gt;&lt;hr style='border:0; border-top:1px solid #ddd6fe; margin:8px 15px;'&gt;&lt;span style='font-size:11px; color:#475569;'&gt;Questions · Auth · Grading&lt;br&gt;Swagger OpenAPI UI&lt;/span&gt;" vertex="1">
          <mxGeometry x="670" y="180" width="250" height="170" as="geometry" />
        </mxCell>

        <!-- SignalR Hub -->
        <mxCell id="c_signalr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#c026d3;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#0f172a;fontFamily=Arial;shadow=1;" value="&lt;div style='font-size:36px; margin-bottom:8px;'&gt;⚡&lt;/div&gt;&lt;b style='font-size:15px; color:#a21caf;'&gt;SignalR Hub&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px; color:#64748b;'&gt;Endpoint: /interviewHub&lt;/span&gt;&lt;hr style='border:0; border-top:1px solid #f5d0fe; margin:8px 15px;'&gt;&lt;span style='font-size:11px; color:#475569;'&gt;Phòng thi trực tuyến thời gian thực&lt;br&gt;WebSockets Full-Duplex&lt;/span&gt;" vertex="1">
          <mxGeometry x="670" y="420" width="250" height="170" as="geometry" />
        </mxCell>

        <!-- Architecture Tag -->
        <mxCell id="c_onion" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#c4b5fd;align=center;verticalAlign=middle;fontColor:#5b21b6;fontFamily=Arial;fontSize=11;fontStyle=1;" value="🧅 Clean / Onion Architecture Pattern" vertex="1">
          <mxGeometry x="670" y="620" width="250" height="35" as="geometry" />
        </mxCell>


        <!-- ============================================== -->
        <!-- 4. DATA & EXTERNAL AI CLOUD                    -->
        <!-- ============================================== -->
        <mxCell id="group_cloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontColor=#334155;fontFamily=Arial;fontSize=14;fontStyle=1;" value="PERSISTENCE &amp; CLOUD AI SERVICES" vertex="1">
          <mxGeometry x="1010" y="120" width="380" height="580" as="geometry" />
        </mxCell>

        <!-- SQL Server Database Cylinder -->
        <mxCell id="c_db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;align=center;verticalAlign=middle;fontColor=#065f46;fontFamily=Arial;shadow=1;" value="&lt;div style='font-size:26px;'&gt;🗄️&lt;/div&gt;&lt;b style='font-size:15px;'&gt;SQL Server&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px; color:#047857;'&gt;Azure SQL Database&lt;br&gt;Questions, Rubrics, ExamSessions&lt;/span&gt;" vertex="1">
          <mxGeometry x="1075" y="165" width="250" height="120" as="geometry" />
        </mxCell>

        <!-- Azure Speech Service -->
