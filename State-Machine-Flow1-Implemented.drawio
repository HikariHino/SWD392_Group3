<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="flow1-implemented" name="Flow 1 - Implemented Question Lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="STATE MACHINE DIAGRAM — IMPLEMENTED QUESTION LIFECYCLE (FLOW 1)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontStyle=1;fontColor=#17324d;" vertex="1" parent="1"><mxGeometry x="180" y="25" width="1040" height="40" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Implemented in current backend: AI generation, FluentValidation, Question/Rubric persistence, update and soft delete" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#52657b;" vertex="1" parent="1"><mxGeometry x="170" y="65" width="1060" height="30" as="geometry" /></mxCell>

        <mxCell id="initial" style="shape=umlInitialState;html=1;fillColor=#1f2937;strokeColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="675" y="115" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="draft" value="&lt;b&gt;Draft&lt;/b&gt;&lt;br&gt;&lt;br&gt;Question data is prepared&lt;br&gt;(manual input or AI result)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3973ac;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#17324d;spacing=12;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="260" height="105" as="geometry" /></mxCell>
        <mxCell id="validating" value="&lt;b&gt;Validating&lt;/b&gt;&lt;br&gt;&lt;br&gt;FluentValidation&lt;br&gt;Weight total must equal 100%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0c4a6e;spacing=12;" vertex="1" parent="1"><mxGeometry x="560" y="370" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="saved" value="&lt;b&gt;Saved&lt;/b&gt;&lt;br&gt;&lt;br&gt;Question + active Rubrics&lt;br&gt;persisted in SQL Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#46966b;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#173d2b;spacing=12;" vertex="1" parent="1"><mxGeometry x="560" y="555" width="260" height="105" as="geometry" /></mxCell>
        <mxCell id="updating" value="&lt;b&gt;Updating&lt;/b&gt;&lt;br&gt;&lt;br&gt;PUT question&lt;br&gt;Replace active Rubric matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#7c2d12;spacing=12;" vertex="1" parent="1"><mxGeometry x="180" y="555" width="260" height="105" as="geometry" /></mxCell>
        <mxCell id="softdeleted" value="&lt;b&gt;SoftDeleted&lt;/b&gt;&lt;br&gt;&lt;br&gt;Question.IsDeleted = true&lt;br&gt;Rubrics.IsDeleted = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#991b1b;spacing=12;" vertex="1" parent="1"><mxGeometry x="940" y="555" width="260" height="105" as="geometry" /></mxCell>
        <mxCell id="final" style="shape=umlActivityFinal;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1050" y="750" width="42" height="42" as="geometry" /></mxCell>

        <mxCell id="e1" value="CreateQuestion() / AI Generate()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="initial" target="draft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="SubmitQuestion()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="draft" target="validating"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="[Weight != 100%] / HTTP 400 + validation errors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#991b1b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="validating" target="draft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="425" /><mxPoint x="500" y="245" /></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="[Weight == 100%] / SaveQuestionAndRubrics()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#166534;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="validating" target="saved"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="PUT /api/questions/{id}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ea580c;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c2d12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="saved" target="updating"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="610" /></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="Validate new content and Rubrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ea580c;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c2d12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="updating" target="validating"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="425" /></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="Valid update / save replacement Rubrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#166534;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="updating" target="saved"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="700" /><mxPoint x="690" y="700" /></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="DELETE /api/questions/{id} / Set IsDeleted = true" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#991b1b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="saved" target="softdeleted"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="Final" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="softdeleted" target="final"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="&lt;b&gt;Scope note&lt;/b&gt;&lt;br&gt;Draft, Validating and Saved are workflow concepts; Question has no Status field.&lt;br&gt;Approved, InExamSession, Lock/Unlock, DiscardDraft and Audit History are not implemented in the current backend." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontFamily=Arial;fontSize=14;fontColor=#1e293b;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="260" y="800" width="880" height="70" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
